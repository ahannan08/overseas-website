# SMTP settings (Hostinger: smtp.hostinger.com, port 465, secure true)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@overseas.org
SMTP_PASS=your-mailbox-password

# Where enquiry emails are delivered (defaults to site contact email)
LEAD_TO_EMAIL=support@overseas.org

# Optional: custom From address (defaults to SMTP_USER)
# LEAD_FROM_EMAIL=support@overseas.org
